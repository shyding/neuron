{
    "tag_regex": [
        {
            "type": 3,
            "regex": "^(U|B|T|C|R|N)[0-9]+:[0-9]+(#B|#L|)(\\.PRE|\\.ACC)?$"
        },
        {
            "type": 4,
            "regex": "^(U|B|T|C|R|N)[0-9]+:[0-9]+(#B|#L|)(\\.PRE|\\.ACC)?$"
        },
        {
            "type": 5,
            "regex": "^(U|B|T|C|R|N)[0-9]+:[0-9]+(#BB|#BL|#LL|#LB|)$"
        },
        {
            "type": 6,
            "regex": "^(U|B|T|C|R|N)[0-9]+:[0-9]+(#BB|#BL|#LL|#LB|)$"
        },
		{
			"type": 9,
			"regex": "^(F)[0-9]+:[0-9]+(#BB|#BL|#LL|#LB|)$"
		},
        {
            "type": 11,
            "regex": "^(U|B|T|C|R|N)[0-9]+:[0-9]+.([0-9]|[1][0-5])$"
        },
		{
			"type": 13,
			"regex": "^(A[0-9]+:[0-9]+\\.[0-9]+(H|L|)|S[0-9]+:[0-9]+(H|L|))$"
		}
    ],
    "group_interval": 1000,
    "timeout": {
        "name": "Connection Timeout (ms)",
        "name_zh": "连接超时时间 (ms)",
        "attribute": "required",
        "type": "int",
        "default": 3000,
        "valid": {
            "min": 1000,
            "max": 65535
        }
    },
    "interval": {
        "name": "Send Interval (s)",
        "name_zh": "指令发送间隔 (s)",
        "attribute": "required",
        "type": "int",
        "default": 30,
        "valid": {
            "min": 10,
            "max": 1000
        }
    },
    "device": {
        "name": "Serial Device",
        "name_zh": "串口设备",
        "attribute": "required",
        "type": "string",
        "valid": {
            "length": 30
        }
    },
