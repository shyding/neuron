                    "value": 5
                }
            ]
        }
    },
    "node": {
        "name": "Node Name",
        "name_zh": "节点名",
        "attribute": "required",
        "type": "string",
        "valid": {
            "length": 255
        }
    },
    "batch_size": {
        "name": "Batch Size",
        "name_zh": "批量大小",
        "description": "Number of messages to be sent in one batch",
        "description_zh": "一次发送的消息数量",
        "attribute": "required",
        "type": "int",
        "default": 10,
        "valid": {
            "min": 1,
            "max": 100
        }
    },
    "expires": {
        "name": "Expires",
        "name_zh": "过期时间",
        "description": "Queue expiration time",
        "description_zh": "队列过期时间",
        "attribute": "required",
        "type": "int",
        "default": 2000,
        "valid": {
            "min": 1,
            "max": 65535
        }
    },
    "sliding_window": {
        "name": "Sliding Window",
        "name_zh": "飞行窗口",
