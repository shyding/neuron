    "group_interval": 2000,
    "host": {
        "name": "HUB IP Address",
        "name_zh": "HUB IP 地址",
        "attribute": "required",
        "type": "string",
        "valid": {
            "regex": "/^((2[0-4]\\d|25[0-5]|[01]?\\d\\d?)\\.){3}(2[0-4]\\d|25[0-5]|[01]?\\d\\d?)$/",
            "length": 30
        }
    },
    "port": {
        "name": "HUB Port",
        "name_zh": "HUB 端口",
        "attribute": "required",
        "type": "int",
        "default": 17889,
        "valid": {
            "min": 1,
            "max": 65535
        }
    },
    "type": {
        "name": "Node Type",
        "name_zh": "节点类型",
        "attribute": "required",
        "type": "map",
        "default": 1,
        "valid": {
            "map": [
                {
                    "key": "OPC DA",
                    "value": 1
                },
                {
