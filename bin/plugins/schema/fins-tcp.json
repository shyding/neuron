			"regex": "(^(CIO|A|W|H|D|P)[0-9]+|^EM[0-9]+W[0-9]+)(#B|#L|)$"
		},
		{
			"type": 5,
			"regex": "(^(CIO|A|W|H|D|P)[0-9]+|^EM[0-9]+W[0-9]+)+(#BB|#BL|#LL|#LB|)$"
		},
		{
			"type": 6,
			"regex": "(^(CIO|A|W|H|D|P)[0-9]+|^EM[0-9]+W[0-9]+)+(#BB|#BL|#LL|#LB|)$"
		},
		{
			"type": 7,
			"regex": "(^(CIO|A|W|H|D|P)[0-9]+|^EM[0-9]+W[0-9]+)+(#B|#L|)$"
		},
		{
			"type": 8,
			"regex": "(^(CIO|A|W|H|D|P)[0-9]+|^EM[0-9]+W[0-9]+)+(#B|#L|)$"
		},
		{
			"type": 9,
			"regex": "(^(CIO|A|W|H|D|P)[0-9]+|^EM[0-9]+W[0-9]+)+(#BB|#BL|#LL|#LB|)$"
		},
		{
			"type": 10,
			"regex": "(^(CIO|A|W|H|D|P)[0-9]+|^EM[0-9]+W[0-9]+)+(#BB|#BL|#LL|#LB|)$"
		},
		{
			"type": 11,
			"regex": "(^(CIO|A|W|H|D|P)[0-9]+|^EM[0-9]+W[0-9]+)\\.([0-9]|1[0-5])$"
		},
		{
			"type": 13,
			"regex": "(^(CIO|A|W|H|D|P)[0-9]+|^EM[0-9]+W[0-9]+)\\.[0-9]+(H|L|)$"
		}
