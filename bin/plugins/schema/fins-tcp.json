		"name_zh": "目标设备 PLC IP 地址",
		"attribute": "required",
		"type": "string",
		"valid": {
			"regex": "/^((2[0-4]\\d|25[0-5]|[01]?\\d\\d?)\\.){3}(2[0-4]\\d|25[0-5]|[01]?\\d\\d?)$/",
