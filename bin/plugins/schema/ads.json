{
  "tag_regex": [
    {
      "type": 1,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+)$"
    },
    {
      "type": 2,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+)$"
    },
    {
      "type": 3,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+)$"
    },
    {
      "type": 4,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+)$"
    },
    {
      "type": 5,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+)$"
    },
    {
      "type": 6,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+)$"
    },
    {
      "type": 7,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+)$"
    },
    {
      "type": 8,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+)$"
    },
    {
      "type": 9,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+)$"
    },
    {
      "type": 10,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+)$"
    },
    {
      "type": 12,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+)$"
    },
    {
      "type": 13,
      "regex": "^((0[xX][0-9a-fA-F]+)|\\d+),((0[xX][0-9a-fA-F]+)|\\d+).\\d+$"
    }
  ],
  "group_interval": 100,
  "host": {
    "name": "Target PLC IP Address",
    "name_zh": "目标设备 IP 地址",
    "attribute": "required",
    "type": "string",
    "valid": {
      "regex": "/^((2[0-4]\\d|25[0-5]|[01]?\\d\\d?)\\.){3}(2[0-4]\\d|25[0-5]|[01]?\\d\\d?)$/",
      "length": 30
    }
  },
  "port": {
    "name": "Target PLC Port",
    "name_zh": "目标设备 PLC 端口号",
    "attribute": "required",
    "type": "int",
    "default": 48898,
    "valid": {
      "min": 1,
      "max": 65535
    }
  },
  "src-ams-net-id": {
    "name": "Source AdsAmsNetId",
    "name_zh": "源 AdsAmsNetId",
    "description": "Source AMS Net ID.  Example: 192.168.1.152.1.1",
    "description_zh": "源 AMS Net ID.  例如： 192.168.1.152.1.1",
    "attribute": "required",
    "type": "string",
    "valid": {
      "regex": "/^((2[0-4]\\d|25[0-5]|[01]?\\d\\d?)\\.){5}(2[0-4]\\d|25[0-5]|[01]?\\d\\d?)$/",
      "length": 30
    }
  },
  "src-ads-port": {
    "name": "Source AdsPortNr",
    "name_zh": "源 AdsPortNr",
    "description": "Source ADS port number",
    "description_zh": "源 ADS 端口号",
    "attribute": "required",
    "type": "int",
    "default": 851,
    "valid": {
      "min": 1,
      "max": 65535
    }
  },
  "dst-ams-net-id": {
    "name": "Target AdsAmsNetId",
    "name_zh": "目标 AdsAmsNetId",
    "description": "Target AMS Net ID.  Example: 192.168.1.157.1.1",
    "description_zh": "目标 AMS Net ID.  例如： 192.168.1.157.1.1",
    "attribute": "required",
    "type": "string",
    "valid": {
      "regex": "/^((2[0-4]\\d|25[0-5]|[01]?\\d\\d?)\\.){5}(2[0-4]\\d|25[0-5]|[01]?\\d\\d?)$/",
      "length": 30
    }
  },
  "dst-ads-port": {
    "name": "Target AdsPortNr",
    "name_zh": "目标 AdsPortNr",
    "description": "Target ADS port number",
    "description_zh": "目标 ADS 端口号",
    "attribute": "required",
    "type": "int",
    "default": 851,
    "valid": {
      "min": 1,
      "max": 65535
    }
  }
}