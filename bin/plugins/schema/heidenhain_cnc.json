{
    "tag_regex": [
        {
            "type": 1,
            "regex": "^B[0-9]+$"
        },
        {
            "type": 2,
            "regex": "^B[0-9]+$"
        },
        {
            "type": 3,
            "regex": "(runState|controlMode|spindleToolIndex|spindleToolAxis|(^(B|W|N|U)[0-9]+$))"
        },
        {
            "type": 4,
            "regex": "(runState|controlMode|spindleToolIndex|spindleToolAxis|(^(B|W|N|U)[0-9]+$))"
        },
        {
            "type": 5,
            "regex": "(programLineNo|spindleToolNumber|feedOverride|spindleOverride|rapidOverride|(^(B|W|N|U|D)[0-9]+$))"
        },
        {
            "type": 6,
            "regex": "(programLineNo|spindleToolNumber|feedOverride|spindleOverride|rapidOverride|(^(B|W|N|U|D)[0-9]+$))"
        },
        {
            "type": 7,
            "regex": "^(B|W|N|U|D)[0-9]+$"
        },
        {
            "type": 8,
            "regex": "^(B|W|N|U|D)[0-9]+$"
        },
        {
            "type": 9,
            "regex": "^(B|W|N|U|D)[0-9]+$"
        },
        {
            "type": 10,
            "regex": "(spindleToolLength|spindleToolRadius|machinePosition\\.[A-Z]+$|(^(B|W|N|U|D)[0-9]+$))"
        },
        {
            "type": 12,
            "regex": "^(M|I|O|T|C)[0-9]+$"    
        },
        {
            "type": 13,
            "regex": "(programMain|programCurrent|parameter.+|^S[0-9]+\\.[0-9]+$)"
        }
    ],
    "group_interval": 3000,
    "host": {
        "name": "CNC IP Address",
        "name_zh": "CNC IP地址",
        "attribute": "required",
        "type": "string",
        "valid": {
            "regex": "/^((2[0-4]\\d|25[0-5]|[01]?\\d\\d?)\\.){3}(2[0-4]\\d|25[0-5]|[01]?\\d\\d?)$/",
            "length": 30
        }
    },
    "port": {
        "name": "CNC Port",
        "name_zh": "CNC 端口",
        "attribute": "required",
        "type": "int",
        "default": 19000,
        "valid": {
            "min": 1,
            "max": 65535
        }
    },
    "timeout": {
		"name": "Connection Timeout (ms)",
		"name_zh": "连接超时时间 (ms)",
		"attribute": "required",
		"type": "int",
		"default": 5000,
		"valid": {
			"min": 1000,
			"max": 65535
		}
	}
}