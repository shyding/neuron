{
    "tag_regex": [
        {
            "type": 1,
            "regex": "^[0-9]+#0[046]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]$"
        },
        {
            "type": 2,
            "regex": "^[0-9]+#0[046]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]$"
        },
        {
            "type": 3,
            "regex": "^[0-9]+#0[024]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]$"
        },
        {
            "type": 4,
            "regex": "^[0-9]+#0[024]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]$"
        },
        {
            "type": 5,
            "regex": "^[0-9]+#0[0245]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E](#[0-9]+|)$"
        },
        {
            "type": 6,
            "regex": "^[0-9]+#0[0245]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E](#[0-9]+|)$"
        },
        {
            "type": 7,
            "regex": "^[0-9]+#0[0146]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]$"
        },
        {
            "type": 8,
            "regex": "^[0-9]+#0[0146]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]$"
        },
        {
            "type": 13,
            "regex": "^[0-9]+#0[01456]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E]-[0-9A-E][0-9A-E](#T|#[0-9]+#T|)$"
        }
    ],
    "group_interval": 1000,
    "link": {
        "name": "Physical Link",
        "name_zh": "物理链路",
        "description": "Serial or Ethernet",
        "description_zh": "串口连接或以太网连接",
        "attribute": "required",
        "type": "map",
        "default": 0,
        "valid": {
            "map": [
                {
                    "key": "Serial",
                    "value": 0
                },
                {
                    "key": "TCP",
                    "value": 1
                }
            ]
        }
    },
    "timeout": {
        "name": "Connection Timeout (ms)",
        "name_zh": "连接超时时间 (ms)",
        "attribute": "required",
        "type": "int",
        "default": 3000,
        "valid": {
            "min": 1000,
            "max": 65535
        }
    },
    "interval": {
        "name": "Send Interval (ms)",
        "name_zh": "指令发送间隔 (ms)",
        "attribute": "required",
        "type": "int",
        "default": 30,
        "valid": {
            "min": 10,
            "max": 1000
        }
    },
    "device": {
        "name": "Serial Device",
        "name_zh": "串口设备",
        "attribute": "required",
        "type": "string",
        "condition": {
            "field": "link",
            "value": 0
        },
        "valid": {
            "length": 30
        }
    },
    "stop": {
