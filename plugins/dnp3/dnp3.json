{
    "tag_regex": [
        {
            "type": 2,
            "regex": "^CROB\\.[0-9]+:[0-9]+:[0-9]+:[0-9]+"
        },
        {
            "type": 3,
            "regex": "^(20|22|30|40|41)\\.(2|4|6)\\.[0-9]+(|\\.value)"
        },
        {
            "type": 4,
            "regex": "^(20|22|30|40|41)\\.(2|4|6)\\.[0-9]+(|\\.value)"
        },
        {
            "type": 5,
            "regex": "^(20|21|22|30|40|41)\\.(1|3|5)\\.[0-9]+(|\\.value)"
        },
        {
            "type": 6,
            "regex": "^(20|21|22|30|40|41)\\.(1|3|5)\\.[0-9]+(|\\.value)"
        },
        {
            "type": 9,
            "regex": "^(30|32|40|41|42)\\.(3|5|7)\\.[0-9]+(|\\.value)"
        },
        {
            "type": 11,
            "regex": "^(1|2|10||11)\\.(1|2|3)\\.[0-9]+(|\\.value)"
        }
    ],
    "group_interval": 1000,
    "host": {
