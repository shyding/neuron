{
  "tag_regex": [
    {
      "type": 1,
      "regex": "^(\\d|(1[0-5]))/(\\d|(1[0-5]))/(\\d|(1[0-5])),(\\d|(1[0-5]))\\.(\\d|(1[0-5]))\\.(\\d|(1[0-5]))$"
    },
    {
      "type": 2,
      "regex": "^(\\d|(1[0-5]))/(\\d|(1[0-5]))/(\\d|(1[0-5])),(\\d|(1[0-5]))\\.(\\d|(1[0-5]))\\.(\\d|(1[0-5]))((,(2|4))?)$"
    },
    {
      "type": 3,
      "regex": "^(\\d|(1[0-5]))/(\\d|(1[0-5]))/(\\d|(1[0-5])),(\\d|(1[0-5]))\\.(\\d|(1[0-5]))\\.(\\d|(1[0-5]))$"
    },
    {
      "type": 4,
      "regex": "^(\\d|(1[0-5]))/(\\d|(1[0-5]))/(\\d|(1[0-5])),(\\d|(1[0-5]))\\.(\\d|(1[0-5]))\\.(\\d|(1[0-5]))$"
    },
    {
      "type": 5,
      "regex": "^(\\d|(1[0-5]))/(\\d|(1[0-5]))/(\\d|(1[0-5])),(\\d|(1[0-5]))\\.(\\d|(1[0-5]))\\.(\\d|(1[0-5]))$"
    },
    {
      "type": 6,
      "regex": "^(\\d|(1[0-5]))/(\\d|(1[0-5]))/(\\d|(1[0-5])),(\\d|(1[0-5]))\\.(\\d|(1[0-5]))\\.(\\d|(1[0-5]))$"
    },
    {
      "type": 9,
      "regex": "^(\\d|(1[0-5]))/(\\d|(1[0-5]))/(\\d|(1[0-5])),(\\d|(1[0-5]))\\.(\\d|(1[0-5]))\\.(\\d|(1[0-5]))$"
    },
    {
      "type": 11,
      "regex": "^(\\d|(1[0-5]))/(\\d|(1[0-5]))/(\\d|(1[0-5])),(\\d|(1[0-5]))\\.(\\d|(1[0-5]))\\.(\\d|(1[0-5]))$"
    },
    {
      "type": 12,
      "regex": "^(\\d|(1[0-5]))/(\\d|(1[0-5]))/(\\d|(1[0-5])),(\\d|(1[0-5]))\\.(\\d|(1[0-5]))\\.(\\d|(1[0-5]))$"
    }
  ],
  "group_interval": 1000,
  "discovery-ip": {
    "name": "Discovery Endpoint IP",
    "name_zh": "发现端点 IP",
    "description": "KNXnet/IP coupler discovery endpoint IPv4 address",
    "description_zh": "KNXnet/IP 耦合器发现端点 IPv4 地址",
    "attribute": "required",
    "type": "string",
    "default": "224.0.23.12",
    "valid": {
      "regex": "/^((2[0-4]\\d|25[0-5]|[01]?\\d\\d?)\\.){3}(2[0-4]\\d|25[0-5]|[01]?\\d\\d?)$/",
      "length": 30
    }
  },
  "discovery-port": {
    "name": "Discovery Endpoint Port",
    "name_zh": "发现端点端口号",
    "description": "KNXnet/IP coupler discovery endpoint UDP port",
    "description_zh": "KNXnet/IP 耦合器发现端点 UDP 端口号",
    "attribute": "required",
    "type": "int",
    "default": 3671,
    "valid": {
      "min": 1,
      "max": 65535
    }
  }
}