    "group_interval": 1000,
    "host": {
        "name": "Target Device IP Address",
        "name_zh": "目标设备 IP 地址",
        "attribute": "required",
        "type": "string",
        "valid": {
            "regex": "/^((2[0-4]\\d|25[0-5]|[01]?\\d\\d?)\\.){3}(2[0-4]\\d|25[0-5]|[01]?\\d\\d?)$/",
            "length": 30
        }
    },
    "port": {
        "name": "Target Device Port",
        "name_zh": "目标设备端口号",
        "attribute": "required",
        "type": "int",
        "default": 5000,
        "valid": {
            "min": 1,
            "max": 65535
        }
    },
    "deviceid": {
        "name": "Target Device ID",
        "name_zh": "目标设备 ID",
        "attribute": "required",
        "type": "int",
        "default": 0,
