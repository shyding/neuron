	"host": {
		"name": "PLC IP Address",
		"name_zh": "PLC IP地址",
		"description": "Target PLC IPv4 address",
		"description_zh": "目标设备 IPv4 地址",
		"attribute": "required",
		"type": "string",
		"valid": {
			"regex": "/^((2[0-4]\\d|25[0-5]|[01]?\\d\\d?)\\.){3}(2[0-4]\\d|25[0-5]|[01]?\\d\\d?)$/",
			"length": 30
		}
	},
	"port": {
		"name": "PLC Port",
		"name_zh": "PLC 端口",
		"description": "Target PLC port",
		"description_zh": "目标设备端口号",
		"attribute": "required",
		"type": "int",
		"default": 44818,
		"valid": {
			"min": 1,
			"max": 65535
		}
	},
	"interval": {
		"name": "Read Interval",
		"name_zh": "读取间隔",
		"description": "Interval(ms) for reading tags from the PLC",
		"description_zh": "从PLC读取标签的间隔时间(ms)",
		"attribute": "required",
		"type": "int",
		"default": 3000,
		"valid": {
			"min": 30,
			"max": 3600000
		}
	},
	"compatibility_mode": {
		"name": "Compatibility Mode",
		"name_zh": "兼容模式",
		"description": "Route the connection through the backplane, needed when the EtherNet/IP port is a separate communication module instead of the CPU itself",
		"description_zh": "经背板路由建立连接，当 EtherNet/IP 网口是独立通讯模块而非 CPU 自带网口时需要启用",
		"attribute": "optional",
		"type": "bool",
		"default": false
	},
	"slot": {
		"name": "PLC CPU Slot",
		"name_zh": "PLC CPU 槽号",
		"description": "Slot of the CPU in the chassis, used as the link address of the backplane port segment",
		"description_zh": "CPU 在机架中的槽号，作为背板端口段的链路地址",
		"attribute": "required",
		"type": "int",
		"default": 0,
		"valid": {
			"min": 0,
			"max": 255
		},
		"condition": {
			"field": "compatibility_mode",
			"value": true
		}
	}
